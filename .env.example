# ApexCanopy 3D Product Configurator - Environment Configuration

# Optional: Base URL for the Pricing API.
# Leave empty for same-origin deployments (e.g. Vercel serverless / Vite proxy).
# Set to an absolute URL if running backend on a separate host (e.g. Render, Railway, AWS).
# Example: VITE_API_BASE_URL=https://api.yourdomain.com
VITE_API_BASE_URL=

# Port for standalone Express API server (default: 5001)
PORT=5001
